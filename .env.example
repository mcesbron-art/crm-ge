# ============================================================
# CRM Groupe Echo — Variables d'environnement
# Copier ce fichier en `.env.local` (dev) et configurer dans Vercel (prod).
# `.env.local` est ignore par Git (voir .gitignore).
# ============================================================

# ------------------------------------------------------------
# AXONAUT — Recuperation projets + creation factures
# ------------------------------------------------------------
# Obtention : Axonaut > Parametres > API > Cle API
# IMPORTANT : ne JAMAIS committer cette cle.
# Cette cle est server-side uniquement (utilisee dans /api/axonaut/*).
AXONAUT_API_KEY=

# URL de l'API Axonaut (defaut : https://axonaut.com/api/v2)
AXONAUT_API_URL=https://axonaut.com/api/v2

# ------------------------------------------------------------
# SUPABASE — Base de donnees + Auth + Storage (a configurer pour la migration)
# ------------------------------------------------------------
# Obtention : Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle SERVICE ROLE — server-side uniquement, ne JAMAIS exposer au client
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# MICROSOFT GRAPH (Sprint 6 — envoi emails depuis Outlook)
# ------------------------------------------------------------
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------
# CONFIG APP
# ------------------------------------------------------------
# URL publique de l'app (utilisee dans les liens BAT envoyes aux clients)
NEXT_PUBLIC_APP_URL=https://crm.groupe-echo.fr

# Taux horaire de reference pour le calcul du temps alloue (marge / taux)
NEXT_PUBLIC_TAUX_HORAIRE_REFERENCE=83
