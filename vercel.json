{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/axonaut/contracts-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/axonaut/tickets-sync",
      "schedule": "0 6 * * *"
    }
  ]
}
